<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тестирование потокового видео</title>
    <style>
        #videoCanvas {
            width: 100%;
            height: auto;
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <h1>Потоковое видео</h1>
    <canvas id="videoCanvas"></canvas>
    <button id="startStreamButton">Начать стрим</button>
    <button id="stopStreamButton" style="display:none;">Остановить стрим</button>
    
    <script>
        const canvas = document.getElementById('videoCanvas');
        const ctx = canvas.getContext('2d');
        const ws = new WebSocket('ws://89.104.71.153:8081/ws');

        ws.binaryType = "arraybuffer";

        ws.onopen = () => {
            console.log('WebSocket подключен');
        };

        ws.onmessage = (event) => {
            if (event.data instanceof ArrayBuffer) {
                const blob = new Blob([event.data], { type: 'image/jpeg' });
                const img = new Image();
                img.onload = () => {
                    canvas.width = img.width;
                    canvas.height = img.height;
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                };
                img.src = URL.createObjectURL(blob);
            }
        };

        ws.onclose = () => {
            console.log('WebSocket отключен');
        };

        ws.onerror = (error) => {
            console.error('Ошибка WebSocket:', error);
        };

        // Запуск стрима
        const startStreamButton = document.getElementById('startStreamButton');
        const stopStreamButton = document.getElementById('stopStreamButton');

        startStreamButton.addEventListener('click', () => {
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ command: 'startStreaming' }));
                startStreamButton.style.display = 'none';
                stopStreamButton.style.display = 'inline-block';
            } else {
                console.error('WebSocket не готов для отправки команды');
            }
        });

        // Остановка стрима
        stopStreamButton.addEventListener('click', () => {
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ command: 'stopStreaming' }));
                startStreamButton.style.display = 'inline-block';
                stopStreamButton.style.display = 'none';
            } else {
                console.error('WebSocket не готов для отправки команды');
            }
        });
    </script>
</body>
</html>
