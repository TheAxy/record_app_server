                        <button id="rewindBack" class="item-video__button btn">J ←←</button>
                        <button id="prevFrame" class="item-video__button btn">I ←</button>
                        <button id="nextFrame" class="item-video__button btn">O →</button>
                        <button id="rewindForward" class="item-video__button btn">N →→</button>
                        <button id="rewindFramesForward" class="item-video__button btn">M →→→</button>
